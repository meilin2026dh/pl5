    throw new Error("研究参数无效");
  const integer = [
    "hotcold",
    "omission",
    "samePosition",
    "positionNeighbor",
    "multiset",
  ].includes(method);
  const minimum = method === "hotcold" || method === "multiset" ? 1 : 0;
  let maximum=Infinity;
  if(method==='hotcold')maximum=10;
  else if(method==='samePosition'||method==='positionNeighbor')maximum=5;
  else if(['bayes','markov','sumQuantile','spanQuantile'].includes(method)||method.endsWith('Frequency'))maximum=1;
  if (
    parameter < minimum ||
    parameter > maximum ||
    (integer && !Number.isInteger(parameter))
