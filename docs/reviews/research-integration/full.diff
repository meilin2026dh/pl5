        method === "omission"
          ? stats.omissions[p][d] >= 0 && stats.omissions[p][d] <= parameter
          : method === "bayes"
            ? (counts[d] + 1) / (stats.n + 10) >= parameter
            : (trans[d] + 1) / (total + 10) >= parameter,
      );
