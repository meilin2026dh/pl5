+function quickDigits(mode: string, digits: number[]) {
+  const all = Array.from({ length: 10 }, (_, i) => i);
+  switch (mode) {
+    case "大":
+      return all.filter((d) => d >= 5);
+    case "小":
+      return all.filter((d) => d < 5);
+    case "奇":
+      return all.filter((d) => d % 2 === 1);
+    case "偶":
+      return all.filter((d) => d % 2 === 0);
+    default:
+      return all.filter((d) => !digits.includes(d));
+  }
