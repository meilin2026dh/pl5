+    padding: 15px;
+  }
+  .h-tabs {
+    gap: 2px;
+  }
+  .h-tabs button {
+    padding: 8px;
+    font-size: 12px;
+  }
+  .h-table-scroll {
+    margin: 0 12px 18px;
+  }
+  .h-matrix {
