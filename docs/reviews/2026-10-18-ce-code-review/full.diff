+    expect(
+      filter({ positions: sample, rules: [rule("kill", [3, 9])] }).numbers,
+    ).toEqual(["00127"]);
+    expect(
+      filter({ positions: sample, rules: [rule("kill", [2])] }).numbers,
+    ).toEqual([]);
+    expect(
+      filter({ positions: sample, rules: [rule("kill", [2], "exclude")] })
+        .numbers,
+    ).toEqual(["00127"]);
+  });
+  it("拒绝空位置、越界、重复数字、空规则及非法值", () => {
